<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Deny cleartext (HTTP) traffic globally -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust only system-installed CAs (not user-installed) -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Explicitly allow only the production backend domain -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">aureli-9twx.onrender.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
